# Copie para .env e preencha com valores reais. Nunca commitar .env.

DB_URL="jdbc:postgresql://localhost:5432/azizaid_hub"
DB_USERNAME="azizaid"
DB_PASSWORD="troque-por-uma-senha-forte"

# Chave HMAC usada para assinar os JWTs de login. Gere uma nova por ambiente
# (ex: `openssl rand -base64 48`) — nunca reaproveite a de outro ambiente.
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Chave AES de 32 bytes em Base64 que cifra o token do link de convite, só para
# ele poder ser mostrado de novo na lista de links. Gere uma nova por ambiente
# (ex: `openssl rand -base64 32`), nunca reaproveite a de outro ambiente. Trocar
# a chave não invalida os links (a validação é pelo hash), só tira eles da lista.
CONVITE_TOKEN_KEY="troque-por-32-bytes-em-base64"

# Base URL do frontend, usada para montar o link completo do convite público
# de intake (ex: http://localhost:5173/ficha-publica/<token>). Em homologação,
# aponta pro domínio Vercel do frontend; em produção, pro domínio da VPS.
FRONTEND_BASE_URL="http://localhost:5173"

# Origens liberadas no CORS de /api/**, separadas por vírgula, sem barra no fim
# (ex: "https://piaziz-web.vercel.app"). '*' é recusado na inicialização. Se
# ausente, vale o default do application.properties (só localhost). Em produção
# o frontend é servido no mesmo domínio da API, então o CORS nem entra em jogo.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:3000"
